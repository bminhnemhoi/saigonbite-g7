digraph G { graph [fontname="Segoe UI" bgcolor="white" pad="0.3" rankdir=TB nodesep=0.3 ranksep=0.6 splines=spline]; node [fontname="Segoe UI" fontsize=14 color="#12263A" fontcolor="#1F2933"]; edge [fontname="Segoe UI" fontsize=13 color="#3B4A5A" fontcolor="#3B4A5A" arrowsize=1.0 penwidth=1.4 labelfontsize=13];
"OrderService" [shape=plain label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" COLOR="#12263A" BGCOLOR="white"><TR><TD BGCOLOR="#24384C" CELLPADDING="5"><FONT POINT-SIZE="11.5" COLOR="#FFFFFF">«service»</FONT><BR/><FONT COLOR="#FFFFFF" POINT-SIZE="16"><B>OrderService</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5"><FONT FACE="Consolas" POINT-SIZE="13.5">+ PlaceOrder(cmd)<BR ALIGN="LEFT"/></FONT></TD></TR></TABLE>>];
"IPaymentStrategyResolver" [shape=plain label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" COLOR="#12263A" BGCOLOR="white"><TR><TD BGCOLOR="#2E7DAF" CELLPADDING="5"><FONT POINT-SIZE="11.5" COLOR="#FFFFFF">«interface»</FONT><BR/><FONT COLOR="#FFFFFF" POINT-SIZE="16"><B><I>IPaymentStrategyResolver</I></B></FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5"><FONT FACE="Consolas" POINT-SIZE="13.5">+ AvailableFor(type)<BR ALIGN="LEFT"/>+ Resolve(method, type)<BR ALIGN="LEFT"/></FONT></TD></TR></TABLE>>];
"PaymentStrategyResolver" [shape=plain label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" COLOR="#12263A" BGCOLOR="white"><TR><TD BGCOLOR="#24384C" CELLPADDING="5"><FONT POINT-SIZE="11.5" COLOR="#FFFFFF">«service»</FONT><BR/><FONT COLOR="#FFFFFF" POINT-SIZE="16"><B>PaymentStrategyResolver</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5"><FONT FACE="Consolas" POINT-SIZE="13.5">- strategies : IEnumerable&lt;IPaymentStrategy&gt;<BR ALIGN="LEFT"/></FONT></TD></TR></TABLE>>];
"IPaymentStrategy" [shape=plain label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" COLOR="#12263A" BGCOLOR="white"><TR><TD BGCOLOR="#2E7DAF" CELLPADDING="5"><FONT POINT-SIZE="11.5" COLOR="#FFFFFF">«interface»</FONT><BR/><FONT COLOR="#FFFFFF" POINT-SIZE="16"><B><I>IPaymentStrategy</I></B></FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5"><FONT FACE="Consolas" POINT-SIZE="13.5">+ Method : PaymentMethod<BR ALIGN="LEFT"/>+ Group : CustomerType?<BR ALIGN="LEFT"/></FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5"><FONT FACE="Consolas" POINT-SIZE="13.5">+ Pay(order) : PaymentResult<BR ALIGN="LEFT"/>+ Refund(payment) : PaymentResult<BR ALIGN="LEFT"/></FONT></TD></TR></TABLE>>];
"MoMoStrategy" [shape=plain label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" COLOR="#12263A" BGCOLOR="white"><TR><TD BGCOLOR="#E4572E" CELLPADDING="5"><FONT POINT-SIZE="11.5" COLOR="#FFFFFF">«strategy»</FONT><BR/><FONT COLOR="#FFFFFF" POINT-SIZE="16"><B>MoMoStrategy</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5"><FONT FACE="Consolas" POINT-SIZE="13.5">Local · simulated<BR ALIGN="LEFT"/></FONT></TD></TR></TABLE>>];
"VnPayStrategy" [shape=plain label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" COLOR="#12263A" BGCOLOR="white"><TR><TD BGCOLOR="#E4572E" CELLPADDING="5"><FONT POINT-SIZE="11.5" COLOR="#FFFFFF">«strategy»</FONT><BR/><FONT COLOR="#FFFFFF" POINT-SIZE="16"><B>VnPayStrategy</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5"><FONT FACE="Consolas" POINT-SIZE="13.5">Local · simulated<BR ALIGN="LEFT"/></FONT></TD></TR></TABLE>>];
"CashOnDeliveryStrategy" [shape=plain label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" COLOR="#12263A" BGCOLOR="white"><TR><TD BGCOLOR="#E4572E" CELLPADDING="5"><FONT POINT-SIZE="11.5" COLOR="#FFFFFF">«strategy»</FONT><BR/><FONT COLOR="#FFFFFF" POINT-SIZE="16"><B>CashOnDeliveryStrategy</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5"><FONT FACE="Consolas" POINT-SIZE="13.5">both · Total ≤ 1,000,000<BR ALIGN="LEFT"/></FONT></TD></TR></TABLE>>];
"ApplePayStrategy" [shape=plain label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" COLOR="#12263A" BGCOLOR="white"><TR><TD BGCOLOR="#E4572E" CELLPADDING="5"><FONT POINT-SIZE="11.5" COLOR="#FFFFFF">«strategy»</FONT><BR/><FONT COLOR="#FFFFFF" POINT-SIZE="16"><B>ApplePayStrategy</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5"><FONT FACE="Consolas" POINT-SIZE="13.5">Tourist · simulated<BR ALIGN="LEFT"/></FONT></TD></TR></TABLE>>];
"PayPalSandboxStrategy" [shape=plain label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" COLOR="#12263A" BGCOLOR="white"><TR><TD BGCOLOR="#E4572E" CELLPADDING="5"><FONT POINT-SIZE="11.5" COLOR="#FFFFFF">«strategy»</FONT><BR/><FONT COLOR="#FFFFFF" POINT-SIZE="16"><B>PayPalSandboxStrategy</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5"><FONT FACE="Consolas" POINT-SIZE="13.5">Tourist · live sandbox<BR ALIGN="LEFT"/></FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5"><FONT FACE="Consolas" POINT-SIZE="13.5">+ Capture(payment)<BR ALIGN="LEFT"/></FONT></TD></TR></TABLE>>];
"OrderService" -> "IPaymentStrategyResolver" [style=dashed arrowhead=vee label=""];
"IPaymentStrategyResolver" -> "PaymentStrategyResolver" [dir=back arrowtail=empty style=dashed arrowsize=1.1];
"PaymentStrategyResolver" -> "IPaymentStrategy" [dir=both arrowtail=odiamond arrowhead=vee headlabel="5" label="  registered in DI"];
"IPaymentStrategy" -> "MoMoStrategy" [dir=back arrowtail=empty style=dashed arrowsize=1.1];
"IPaymentStrategy" -> "VnPayStrategy" [dir=back arrowtail=empty style=dashed arrowsize=1.1];
"IPaymentStrategy" -> "CashOnDeliveryStrategy" [dir=back arrowtail=empty style=dashed arrowsize=1.1];
"IPaymentStrategy" -> "ApplePayStrategy" [dir=back arrowtail=empty style=dashed arrowsize=1.1];
"IPaymentStrategy" -> "PayPalSandboxStrategy" [dir=back arrowtail=empty style=dashed arrowsize=1.1];
n1 [shape=note style=filled fillcolor="#FFF8E6" color="#E9A23B" fontsize=13 label="BR13: Local → MoMo, VNPay, COD\nTourist → Apple Pay, PayPal, COD\nNFR2: a new method = 1 new class\n+ 1 DI line, 0 edits to old classes"];
"PaymentStrategyResolver" -> n1 [style=dashed arrowhead=none color="#E9A23B"];
{rank=same; "PaymentStrategyResolver"; n1}
legend [shape=plain label=<<TABLE BORDER="0" CELLSPACING="4"><TR><TD BGCOLOR="#2E7DAF" WIDTH="14"></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="13">interface</FONT></TD><TD BGCOLOR="#24384C" WIDTH="14"></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="13">service</FONT></TD><TD BGCOLOR="#E4572E" WIDTH="14"></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="13">concrete strategy (one class per method)</FONT></TD></TR></TABLE>>];
}