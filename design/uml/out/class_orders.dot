digraph G { graph [fontname="Segoe UI" bgcolor="white" pad="0.3" rankdir=LR nodesep=0.25 ranksep=0.8 splines=spline]; node [fontname="Segoe UI" fontsize=14 color="#12263A" fontcolor="#1F2933"]; edge [fontname="Segoe UI" fontsize=13 color="#3B4A5A" fontcolor="#3B4A5A" arrowsize=1.0 penwidth=1.4 labelfontsize=13];
"Customer" [shape=plain label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" COLOR="#12263A" BGCOLOR="white"><TR><TD BGCOLOR="#12263A" CELLPADDING="5"><FONT POINT-SIZE="11.5" COLOR="#FFFFFF">«abstract»</FONT><BR/><FONT COLOR="#FFFFFF" POINT-SIZE="16"><B><I>Customer</I></B></FONT></TD></TR><TR><TD HEIGHT="6"></TD></TR></TABLE>>];
"Hub" [shape=plain label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" COLOR="#12263A" BGCOLOR="white"><TR><TD BGCOLOR="#12263A" CELLPADDING="5"><FONT COLOR="#FFFFFF" POINT-SIZE="16"><B>Hub</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5"><FONT FACE="Consolas" POINT-SIZE="13.5">+ KitchenCapacity : int<BR ALIGN="LEFT"/>+ IsActive : bool<BR ALIGN="LEFT"/></FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5"><FONT FACE="Consolas" POINT-SIZE="13.5">+ LoadPercent(active) : decimal<BR ALIGN="LEFT"/></FONT></TD></TR></TABLE>>];
"Brand" [shape=plain label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" COLOR="#12263A" BGCOLOR="white"><TR><TD BGCOLOR="#12263A" CELLPADDING="5"><FONT COLOR="#FFFFFF" POINT-SIZE="16"><B>Brand</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5"><FONT FACE="Consolas" POINT-SIZE="13.5">+ Name : string<BR ALIGN="LEFT"/>+ Category : string<BR ALIGN="LEFT"/></FONT></TD></TR></TABLE>>];
"MenuItem" [shape=plain label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" COLOR="#12263A" BGCOLOR="white"><TR><TD BGCOLOR="#12263A" CELLPADDING="5"><FONT COLOR="#FFFFFF" POINT-SIZE="16"><B>MenuItem</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5"><FONT FACE="Consolas" POINT-SIZE="13.5">+ Name : string<BR ALIGN="LEFT"/>+ Price : decimal<BR ALIGN="LEFT"/>+ IsAvailable : bool<BR ALIGN="LEFT"/></FONT></TD></TR></TABLE>>];
"Voucher" [shape=plain label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" COLOR="#12263A" BGCOLOR="white"><TR><TD BGCOLOR="#12263A" CELLPADDING="5"><FONT COLOR="#FFFFFF" POINT-SIZE="16"><B>Voucher</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5"><FONT FACE="Consolas" POINT-SIZE="13.5">+ Code : string<BR ALIGN="LEFT"/>+ Type : PERCENT | FIXED<BR ALIGN="LEFT"/>+ Value, MaxDiscount : decimal<BR ALIGN="LEFT"/>+ MinSubtotal : decimal<BR ALIGN="LEFT"/></FONT></TD></TR></TABLE>>];
"Order" [shape=plain label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" COLOR="#12263A" BGCOLOR="white"><TR><TD BGCOLOR="#12263A" CELLPADDING="5"><FONT COLOR="#FFFFFF" POINT-SIZE="16"><B>Order</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5"><FONT FACE="Consolas" POINT-SIZE="13.5">+ Status : OrderStatus<BR ALIGN="LEFT"/>+ DeliveryAddress : string<BR ALIGN="LEFT"/>+ DistanceKm : decimal<BR ALIGN="LEFT"/>+ Method : PaymentMethod<BR ALIGN="LEFT"/>+ Snapshot : PriceSnapshot<BR ALIGN="LEFT"/>+ Price : PriceBreakdown<BR ALIGN="LEFT"/></FONT></TD></TR></TABLE>>];
"OrderLine" [shape=plain label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" COLOR="#12263A" BGCOLOR="white"><TR><TD BGCOLOR="#12263A" CELLPADDING="5"><FONT COLOR="#FFFFFF" POINT-SIZE="16"><B>OrderLine</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5"><FONT FACE="Consolas" POINT-SIZE="13.5">+ UnitPrice : decimal<BR ALIGN="LEFT"/>+ Quantity : int {1..20}<BR ALIGN="LEFT"/></FONT></TD></TR></TABLE>>];
"PriceSnapshot" [shape=plain label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" COLOR="#C8D1DA" BGCOLOR="white"><TR><TD BGCOLOR="#F3E3BF" CELLPADDING="5"><FONT POINT-SIZE="11.5" COLOR="#1F2933">«value object»</FONT><BR/><FONT COLOR="#1F2933" POINT-SIZE="16"><B>PriceSnapshot</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5"><FONT FACE="Consolas" POINT-SIZE="13.5">+ PlacedAtLocal : DateTime<BR ALIGN="LEFT"/>+ HubLoadPercent : decimal<BR ALIGN="LEFT"/>+ HeavyRainOn : bool<BR ALIGN="LEFT"/></FONT></TD></TR></TABLE>>];
"PriceBreakdown" [shape=plain label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" COLOR="#C8D1DA" BGCOLOR="white"><TR><TD BGCOLOR="#F3E3BF" CELLPADDING="5"><FONT POINT-SIZE="11.5" COLOR="#1F2933">«value object»</FONT><BR/><FONT COLOR="#1F2933" POINT-SIZE="16"><B>PriceBreakdown</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5"><FONT FACE="Consolas" POINT-SIZE="13.5">+ S, Q, V : decimal<BR ALIGN="LEFT"/>+ D, R, R2 : decimal<BR ALIGN="LEFT"/>+ Total : decimal<BR ALIGN="LEFT"/></FONT></TD></TR></TABLE>>];
"OrderStatusHistory" [shape=plain label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" COLOR="#12263A" BGCOLOR="white"><TR><TD BGCOLOR="#12263A" CELLPADDING="5"><FONT COLOR="#FFFFFF" POINT-SIZE="16"><B>OrderStatusHistory</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5"><FONT FACE="Consolas" POINT-SIZE="13.5">+ From, To : OrderStatus<BR ALIGN="LEFT"/>+ ActorUserId : int<BR ALIGN="LEFT"/>+ ChangedAtLocal : DateTime<BR ALIGN="LEFT"/></FONT></TD></TR></TABLE>>];
"Payment" [shape=plain label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" COLOR="#12263A" BGCOLOR="white"><TR><TD BGCOLOR="#12263A" CELLPADDING="5"><FONT COLOR="#FFFFFF" POINT-SIZE="16"><B>Payment</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5"><FONT FACE="Consolas" POINT-SIZE="13.5">+ Method : PaymentMethod<BR ALIGN="LEFT"/>+ Amount : decimal<BR ALIGN="LEFT"/>+ Status : PaymentStatus<BR ALIGN="LEFT"/>+ ProviderRef : string?<BR ALIGN="LEFT"/></FONT></TD></TR></TABLE>>];
"Customer" -> "Order" [arrowhead=vee headlabel="*" taillabel="1" label="  places" ];
"Hub" -> "Order" [arrowhead=vee headlabel="*" taillabel="1" label="  cooks" ];
"Voucher" -> "Order" [arrowhead=vee headlabel="*" taillabel="0..1" label="  applied to" ];
"Hub" -> "Brand" [arrowhead=none taillabel="*" headlabel="*" label="  operates"];
"Brand" -> "MenuItem" [dir=both arrowtail=diamond arrowhead=none headlabel="*" taillabel="1" label="  offers"];
"Order" -> "OrderLine" [dir=both arrowtail=diamond arrowhead=none headlabel="1..30" taillabel="1" label=""];
"OrderLine" -> "MenuItem" [arrowhead=vee headlabel="1" taillabel="*" label="" constraint=false];
"Order" -> "PriceSnapshot" [dir=both arrowtail=diamond arrowhead=none headlabel="1" taillabel="1" label=""];
"Order" -> "PriceBreakdown" [dir=both arrowtail=diamond arrowhead=none headlabel="1" taillabel="1" label=""];
"Order" -> "OrderStatusHistory" [dir=both arrowtail=diamond arrowhead=none headlabel="1..*" taillabel="1" label=""];
"Order" -> "Payment" [dir=both arrowtail=diamond arrowhead=none headlabel="1" taillabel="1" label=""];
{rank=same; "Customer"; "Hub"; "Voucher"}
{rank=same; "OrderLine"; "PriceSnapshot"; "PriceBreakdown"; "OrderStatusHistory"; "Payment"}
legend [shape=plain label=<<TABLE BORDER="0" CELLSPACING="4"><TR><TD BGCOLOR="#12263A" WIDTH="14"></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="13">entity</FONT></TD><TD BGCOLOR="#F3E3BF" WIDTH="14"></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="13">value object stored with the order (BR17 snapshot)</FONT></TD></TR></TABLE>>];
}