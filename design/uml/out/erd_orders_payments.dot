digraph E { graph [fontname="Segoe UI" bgcolor="white" pad="0.3" rankdir=LR nodesep=0.3 ranksep=1.0 splines=spline]; node [fontname="Segoe UI" fontsize=14 color="#12263A" fontcolor="#1F2933"]; edge [fontname="Segoe UI" fontsize=13 color="#3B4A5A" fontcolor="#3B4A5A" arrowsize=1.0 penwidth=1.4 labelfontsize=13];
Users [shape=plain label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" COLOR="#9AA5B1" BGCOLOR="white"><TR><TD COLSPAN="3" BGCOLOR="#12263A" CELLPADDING="5"><FONT COLOR="white" POINT-SIZE="15"><B>Users</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="Id" CELLPADDING="3"><FONT COLOR="#E9A23B" POINT-SIZE="12"><B>PK</B></FONT></TD><TD ALIGN="LEFT" CELLPADDING="3"><FONT FACE="Consolas" POINT-SIZE="13.5"><B>Id</B></FONT></TD><TD ALIGN="LEFT" CELLPADDING="3"><FONT FACE="Consolas" POINT-SIZE="12" COLOR="#5B6B7A">int</FONT></TD></TR></TABLE>>];
Hubs [shape=plain label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" COLOR="#9AA5B1" BGCOLOR="white"><TR><TD COLSPAN="3" BGCOLOR="#12263A" CELLPADDING="5"><FONT COLOR="white" POINT-SIZE="15"><B>Hubs</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="Id" CELLPADDING="3"><FONT COLOR="#E9A23B" POINT-SIZE="12"><B>PK</B></FONT></TD><TD ALIGN="LEFT" CELLPADDING="3"><FONT FACE="Consolas" POINT-SIZE="13.5"><B>Id</B></FONT></TD><TD ALIGN="LEFT" CELLPADDING="3"><FONT FACE="Consolas" POINT-SIZE="12" COLOR="#5B6B7A">int</FONT></TD></TR></TABLE>>];
MenuItems [shape=plain label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" COLOR="#9AA5B1" BGCOLOR="white"><TR><TD COLSPAN="3" BGCOLOR="#12263A" CELLPADDING="5"><FONT COLOR="white" POINT-SIZE="15"><B>MenuItems</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="Id" CELLPADDING="3"><FONT COLOR="#E9A23B" POINT-SIZE="12"><B>PK</B></FONT></TD><TD ALIGN="LEFT" CELLPADDING="3"><FONT FACE="Consolas" POINT-SIZE="13.5"><B>Id</B></FONT></TD><TD ALIGN="LEFT" CELLPADDING="3"><FONT FACE="Consolas" POINT-SIZE="12" COLOR="#5B6B7A">int</FONT></TD></TR></TABLE>>];
Vouchers [shape=plain label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" COLOR="#9AA5B1" BGCOLOR="white"><TR><TD COLSPAN="3" BGCOLOR="#12263A" CELLPADDING="5"><FONT COLOR="white" POINT-SIZE="15"><B>Vouchers</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="Id" CELLPADDING="3"><FONT COLOR="#E9A23B" POINT-SIZE="12"><B>PK</B></FONT></TD><TD ALIGN="LEFT" CELLPADDING="3"><FONT FACE="Consolas" POINT-SIZE="13.5"><B>Id</B></FONT></TD><TD ALIGN="LEFT" CELLPADDING="3"><FONT FACE="Consolas" POINT-SIZE="12" COLOR="#5B6B7A">int</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="Code" CELLPADDING="3"><FONT COLOR="#1E8A5F" POINT-SIZE="12"><B>UK</B></FONT></TD><TD ALIGN="LEFT" CELLPADDING="3"><FONT FACE="Consolas" POINT-SIZE="13.5">Code</FONT></TD><TD ALIGN="LEFT" CELLPADDING="3"><FONT FACE="Consolas" POINT-SIZE="12" COLOR="#5B6B7A">nvarchar(32)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="Type" CELLPADDING="3"></TD><TD ALIGN="LEFT" CELLPADDING="3"><FONT FACE="Consolas" POINT-SIZE="13.5">Type</FONT></TD><TD ALIGN="LEFT" CELLPADDING="3"><FONT FACE="Consolas" POINT-SIZE="12" COLOR="#5B6B7A">tinyint</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="Value" CELLPADDING="3"></TD><TD ALIGN="LEFT" CELLPADDING="3"><FONT FACE="Consolas" POINT-SIZE="13.5">Value</FONT></TD><TD ALIGN="LEFT" CELLPADDING="3"><FONT FACE="Consolas" POINT-SIZE="12" COLOR="#5B6B7A">decimal</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="MaxDiscount" CELLPADDING="3"></TD><TD ALIGN="LEFT" CELLPADDING="3"><FONT FACE="Consolas" POINT-SIZE="13.5">MaxDiscount</FONT></TD><TD ALIGN="LEFT" CELLPADDING="3"><FONT FACE="Consolas" POINT-SIZE="12" COLOR="#5B6B7A">decimal</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="MinSubtotal" CELLPADDING="3"></TD><TD ALIGN="LEFT" CELLPADDING="3"><FONT FACE="Consolas" POINT-SIZE="13.5">MinSubtotal</FONT></TD><TD ALIGN="LEFT" CELLPADDING="3"><FONT FACE="Consolas" POINT-SIZE="12" COLOR="#5B6B7A">decimal</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="ValidFrom, ValidTo" CELLPADDING="3"></TD><TD ALIGN="LEFT" CELLPADDING="3"><FONT FACE="Consolas" POINT-SIZE="13.5">ValidFrom, ValidTo</FONT></TD><TD ALIGN="LEFT" CELLPADDING="3"><FONT FACE="Consolas" POINT-SIZE="12" COLOR="#5B6B7A">date</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="IsActive" CELLPADDING="3"></TD><TD ALIGN="LEFT" CELLPADDING="3"><FONT FACE="Consolas" POINT-SIZE="13.5">IsActive</FONT></TD><TD ALIGN="LEFT" CELLPADDING="3"><FONT FACE="Consolas" POINT-SIZE="12" COLOR="#5B6B7A">bit</FONT></TD></TR></TABLE>>];
Orders [shape=plain label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" COLOR="#9AA5B1" BGCOLOR="white"><TR><TD COLSPAN="3" BGCOLOR="#12263A" CELLPADDING="5"><FONT COLOR="white" POINT-SIZE="15"><B>Orders</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="Id" CELLPADDING="3"><FONT COLOR="#E9A23B" POINT-SIZE="12"><B>PK</B></FONT></TD><TD ALIGN="LEFT" CELLPADDING="3"><FONT FACE="Consolas" POINT-SIZE="13.5"><B>Id</B></FONT></TD><TD ALIGN="LEFT" CELLPADDING="3"><FONT FACE="Consolas" POINT-SIZE="12" COLOR="#5B6B7A">int</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="CustomerId" CELLPADDING="3"><FONT COLOR="#2E7DAF" POINT-SIZE="12"><B>FK</B></FONT></TD><TD ALIGN="LEFT" CELLPADDING="3"><FONT FACE="Consolas" POINT-SIZE="13.5">CustomerId</FONT></TD><TD ALIGN="LEFT" CELLPADDING="3"><FONT FACE="Consolas" POINT-SIZE="12" COLOR="#5B6B7A">int</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="HubId" CELLPADDING="3"><FONT COLOR="#2E7DAF" POINT-SIZE="12"><B>FK</B></FONT></TD><TD ALIGN="LEFT" CELLPADDING="3"><FONT FACE="Consolas" POINT-SIZE="13.5">HubId</FONT></TD><TD ALIGN="LEFT" CELLPADDING="3"><FONT FACE="Consolas" POINT-SIZE="12" COLOR="#5B6B7A">int</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="ShipperId" CELLPADDING="3"><FONT COLOR="#2E7DAF" POINT-SIZE="12"><B>FK</B></FONT></TD><TD ALIGN="LEFT" CELLPADDING="3"><FONT FACE="Consolas" POINT-SIZE="13.5">ShipperId</FONT></TD><TD ALIGN="LEFT" CELLPADDING="3"><FONT FACE="Consolas" POINT-SIZE="12" COLOR="#5B6B7A">int null</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="VoucherId" CELLPADDING="3"><FONT COLOR="#2E7DAF" POINT-SIZE="12"><B>FK</B></FONT></TD><TD ALIGN="LEFT" CELLPADDING="3"><FONT FACE="Consolas" POINT-SIZE="13.5">VoucherId</FONT></TD><TD ALIGN="LEFT" CELLPADDING="3"><FONT FACE="Consolas" POINT-SIZE="12" COLOR="#5B6B7A">int null</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="Status" CELLPADDING="3"></TD><TD ALIGN="LEFT" CELLPADDING="3"><FONT FACE="Consolas" POINT-SIZE="13.5">Status</FONT></TD><TD ALIGN="LEFT" CELLPADDING="3"><FONT FACE="Consolas" POINT-SIZE="12" COLOR="#5B6B7A">tinyint</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="DistanceKm" CELLPADDING="3"></TD><TD ALIGN="LEFT" CELLPADDING="3"><FONT FACE="Consolas" POINT-SIZE="13.5">DistanceKm</FONT></TD><TD ALIGN="LEFT" CELLPADDING="3"><FONT FACE="Consolas" POINT-SIZE="12" COLOR="#5B6B7A">decimal(4,2)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="SnapPlacedAtLocal" CELLPADDING="3"></TD><TD ALIGN="LEFT" CELLPADDING="3"><FONT FACE="Consolas" POINT-SIZE="13.5">SnapPlacedAtLocal</FONT></TD><TD ALIGN="LEFT" CELLPADDING="3"><FONT FACE="Consolas" POINT-SIZE="12" COLOR="#5B6B7A">datetime2</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="SnapHubLoadPct" CELLPADDING="3"></TD><TD ALIGN="LEFT" CELLPADDING="3"><FONT FACE="Consolas" POINT-SIZE="13.5">SnapHubLoadPct</FONT></TD><TD ALIGN="LEFT" CELLPADDING="3"><FONT FACE="Consolas" POINT-SIZE="12" COLOR="#5B6B7A">decimal(6,3)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="SnapHeavyRain" CELLPADDING="3"></TD><TD ALIGN="LEFT" CELLPADDING="3"><FONT FACE="Consolas" POINT-SIZE="13.5">SnapHeavyRain</FONT></TD><TD ALIGN="LEFT" CELLPADDING="3"><FONT FACE="Consolas" POINT-SIZE="12" COLOR="#5B6B7A">bit</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="S, Q, V, D, R, R2" CELLPADDING="3"></TD><TD ALIGN="LEFT" CELLPADDING="3"><FONT FACE="Consolas" POINT-SIZE="13.5">S, Q, V, D, R, R2</FONT></TD><TD ALIGN="LEFT" CELLPADDING="3"><FONT FACE="Consolas" POINT-SIZE="12" COLOR="#5B6B7A">decimal(12,0)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="Total" CELLPADDING="3"></TD><TD ALIGN="LEFT" CELLPADDING="3"><FONT FACE="Consolas" POINT-SIZE="13.5">Total</FONT></TD><TD ALIGN="LEFT" CELLPADDING="3"><FONT FACE="Consolas" POINT-SIZE="12" COLOR="#5B6B7A">decimal(12,0)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="PaymentMethod" CELLPADDING="3"></TD><TD ALIGN="LEFT" CELLPADDING="3"><FONT FACE="Consolas" POINT-SIZE="13.5">PaymentMethod</FONT></TD><TD ALIGN="LEFT" CELLPADDING="3"><FONT FACE="Consolas" POINT-SIZE="12" COLOR="#5B6B7A">tinyint</FONT></TD></TR></TABLE>>];
OrderLines [shape=plain label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" COLOR="#9AA5B1" BGCOLOR="white"><TR><TD COLSPAN="3" BGCOLOR="#12263A" CELLPADDING="5"><FONT COLOR="white" POINT-SIZE="15"><B>OrderLines</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="Id" CELLPADDING="3"><FONT COLOR="#E9A23B" POINT-SIZE="12"><B>PK</B></FONT></TD><TD ALIGN="LEFT" CELLPADDING="3"><FONT FACE="Consolas" POINT-SIZE="13.5"><B>Id</B></FONT></TD><TD ALIGN="LEFT" CELLPADDING="3"><FONT FACE="Consolas" POINT-SIZE="12" COLOR="#5B6B7A">int</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="OrderId" CELLPADDING="3"><FONT COLOR="#2E7DAF" POINT-SIZE="12"><B>FK</B></FONT></TD><TD ALIGN="LEFT" CELLPADDING="3"><FONT FACE="Consolas" POINT-SIZE="13.5">OrderId</FONT></TD><TD ALIGN="LEFT" CELLPADDING="3"><FONT FACE="Consolas" POINT-SIZE="12" COLOR="#5B6B7A">int</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="MenuItemId" CELLPADDING="3"><FONT COLOR="#2E7DAF" POINT-SIZE="12"><B>FK</B></FONT></TD><TD ALIGN="LEFT" CELLPADDING="3"><FONT FACE="Consolas" POINT-SIZE="13.5">MenuItemId</FONT></TD><TD ALIGN="LEFT" CELLPADDING="3"><FONT FACE="Consolas" POINT-SIZE="12" COLOR="#5B6B7A">int</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="UnitPrice" CELLPADDING="3"></TD><TD ALIGN="LEFT" CELLPADDING="3"><FONT FACE="Consolas" POINT-SIZE="13.5">UnitPrice</FONT></TD><TD ALIGN="LEFT" CELLPADDING="3"><FONT FACE="Consolas" POINT-SIZE="12" COLOR="#5B6B7A">decimal(12,0)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="Quantity" CELLPADDING="3"></TD><TD ALIGN="LEFT" CELLPADDING="3"><FONT FACE="Consolas" POINT-SIZE="13.5">Quantity</FONT></TD><TD ALIGN="LEFT" CELLPADDING="3"><FONT FACE="Consolas" POINT-SIZE="12" COLOR="#5B6B7A">int 1–20</FONT></TD></TR></TABLE>>];
OrderStatusHistory [shape=plain label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" COLOR="#9AA5B1" BGCOLOR="white"><TR><TD COLSPAN="3" BGCOLOR="#12263A" CELLPADDING="5"><FONT COLOR="white" POINT-SIZE="15"><B>OrderStatusHistory</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="Id" CELLPADDING="3"><FONT COLOR="#E9A23B" POINT-SIZE="12"><B>PK</B></FONT></TD><TD ALIGN="LEFT" CELLPADDING="3"><FONT FACE="Consolas" POINT-SIZE="13.5"><B>Id</B></FONT></TD><TD ALIGN="LEFT" CELLPADDING="3"><FONT FACE="Consolas" POINT-SIZE="12" COLOR="#5B6B7A">bigint</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="OrderId" CELLPADDING="3"><FONT COLOR="#2E7DAF" POINT-SIZE="12"><B>FK</B></FONT></TD><TD ALIGN="LEFT" CELLPADDING="3"><FONT FACE="Consolas" POINT-SIZE="13.5">OrderId</FONT></TD><TD ALIGN="LEFT" CELLPADDING="3"><FONT FACE="Consolas" POINT-SIZE="12" COLOR="#5B6B7A">int</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="FromStatus" CELLPADDING="3"></TD><TD ALIGN="LEFT" CELLPADDING="3"><FONT FACE="Consolas" POINT-SIZE="13.5">FromStatus</FONT></TD><TD ALIGN="LEFT" CELLPADDING="3"><FONT FACE="Consolas" POINT-SIZE="12" COLOR="#5B6B7A">tinyint null</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="ToStatus" CELLPADDING="3"></TD><TD ALIGN="LEFT" CELLPADDING="3"><FONT FACE="Consolas" POINT-SIZE="13.5">ToStatus</FONT></TD><TD ALIGN="LEFT" CELLPADDING="3"><FONT FACE="Consolas" POINT-SIZE="12" COLOR="#5B6B7A">tinyint</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="ActorUserId" CELLPADDING="3"><FONT COLOR="#2E7DAF" POINT-SIZE="12"><B>FK</B></FONT></TD><TD ALIGN="LEFT" CELLPADDING="3"><FONT FACE="Consolas" POINT-SIZE="13.5">ActorUserId</FONT></TD><TD ALIGN="LEFT" CELLPADDING="3"><FONT FACE="Consolas" POINT-SIZE="12" COLOR="#5B6B7A">int</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="ChangedAtLocal" CELLPADDING="3"></TD><TD ALIGN="LEFT" CELLPADDING="3"><FONT FACE="Consolas" POINT-SIZE="13.5">ChangedAtLocal</FONT></TD><TD ALIGN="LEFT" CELLPADDING="3"><FONT FACE="Consolas" POINT-SIZE="12" COLOR="#5B6B7A">datetime2</FONT></TD></TR></TABLE>>];
Payments [shape=plain label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" COLOR="#9AA5B1" BGCOLOR="white"><TR><TD COLSPAN="3" BGCOLOR="#12263A" CELLPADDING="5"><FONT COLOR="white" POINT-SIZE="15"><B>Payments</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="Id" CELLPADDING="3"><FONT COLOR="#E9A23B" POINT-SIZE="12"><B>PK</B></FONT></TD><TD ALIGN="LEFT" CELLPADDING="3"><FONT FACE="Consolas" POINT-SIZE="13.5"><B>Id</B></FONT></TD><TD ALIGN="LEFT" CELLPADDING="3"><FONT FACE="Consolas" POINT-SIZE="12" COLOR="#5B6B7A">int</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="OrderId" CELLPADDING="3"><FONT COLOR="#2E7DAF" POINT-SIZE="12"><B>FK</B></FONT></TD><TD ALIGN="LEFT" CELLPADDING="3"><FONT FACE="Consolas" POINT-SIZE="13.5">OrderId</FONT></TD><TD ALIGN="LEFT" CELLPADDING="3"><FONT FACE="Consolas" POINT-SIZE="12" COLOR="#5B6B7A">int</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="Method" CELLPADDING="3"></TD><TD ALIGN="LEFT" CELLPADDING="3"><FONT FACE="Consolas" POINT-SIZE="13.5">Method</FONT></TD><TD ALIGN="LEFT" CELLPADDING="3"><FONT FACE="Consolas" POINT-SIZE="12" COLOR="#5B6B7A">tinyint</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="Amount" CELLPADDING="3"></TD><TD ALIGN="LEFT" CELLPADDING="3"><FONT FACE="Consolas" POINT-SIZE="13.5">Amount</FONT></TD><TD ALIGN="LEFT" CELLPADDING="3"><FONT FACE="Consolas" POINT-SIZE="12" COLOR="#5B6B7A">decimal(12,0)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="Status" CELLPADDING="3"></TD><TD ALIGN="LEFT" CELLPADDING="3"><FONT FACE="Consolas" POINT-SIZE="13.5">Status</FONT></TD><TD ALIGN="LEFT" CELLPADDING="3"><FONT FACE="Consolas" POINT-SIZE="12" COLOR="#5B6B7A">tinyint</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="ProviderRef" CELLPADDING="3"></TD><TD ALIGN="LEFT" CELLPADDING="3"><FONT FACE="Consolas" POINT-SIZE="13.5">ProviderRef</FONT></TD><TD ALIGN="LEFT" CELLPADDING="3"><FONT FACE="Consolas" POINT-SIZE="12" COLOR="#5B6B7A">nvarchar(64) null</FONT></TD></TR></TABLE>>];
Users:Id -> Orders:CustomerId [dir=both arrowtail=teetee arrowhead=crowodot];
Hubs:Id -> Orders:HubId [dir=both arrowtail=teetee arrowhead=crowodot];
Vouchers:Id -> Orders:VoucherId [dir=both arrowtail=teeodot arrowhead=crowodot];
Orders:Id -> OrderLines:OrderId [dir=both arrowtail=teetee arrowhead=crowtee];
MenuItems:Id -> OrderLines:MenuItemId [dir=both arrowtail=teetee arrowhead=crowodot];
Orders:Id -> OrderStatusHistory:OrderId [dir=both arrowtail=teetee arrowhead=crowtee];
Orders:Id -> Payments:OrderId [dir=both arrowtail=teetee arrowhead=teeodot];
{rank=same; Users; Hubs; Vouchers}
{rank=same; OrderLines; OrderStatusHistory; Payments}
}