digraph G { graph [fontname="Segoe UI" bgcolor="white" pad="0.3" rankdir=TB nodesep=0.35 ranksep=0.6 splines=spline]; node [fontname="Segoe UI" fontsize=14 color="#12263A" fontcolor="#1F2933"]; edge [fontname="Segoe UI" fontsize=13 color="#3B4A5A" fontcolor="#3B4A5A" arrowsize=1.0 penwidth=1.4 labelfontsize=13];
"CheckoutController" [shape=plain label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" COLOR="#12263A" BGCOLOR="white"><TR><TD BGCOLOR="#3B4A5A" CELLPADDING="5"><FONT POINT-SIZE="11.5" COLOR="#FFFFFF">«controller»</FONT><BR/><FONT COLOR="#FFFFFF" POINT-SIZE="16"><B>CheckoutController</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5"><FONT FACE="Consolas" POINT-SIZE="13.5">+ Place(CheckoutVm)<BR ALIGN="LEFT"/></FONT></TD></TR></TABLE>>];
"IOrderService" [shape=plain label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" COLOR="#12263A" BGCOLOR="white"><TR><TD BGCOLOR="#2E7DAF" CELLPADDING="5"><FONT POINT-SIZE="11.5" COLOR="#FFFFFF">«interface»</FONT><BR/><FONT COLOR="#FFFFFF" POINT-SIZE="16"><B><I>IOrderService</I></B></FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5"><FONT FACE="Consolas" POINT-SIZE="13.5">+ PlaceOrder(cmd)<BR ALIGN="LEFT"/>+ EditItems(id, lines)<BR ALIGN="LEFT"/>+ Cancel(id, actor, reason)<BR ALIGN="LEFT"/></FONT></TD></TR></TABLE>>];
"OrderService" [shape=plain label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" COLOR="#12263A" BGCOLOR="white"><TR><TD BGCOLOR="#24384C" CELLPADDING="5"><FONT POINT-SIZE="11.5" COLOR="#FFFFFF">«service»</FONT><BR/><FONT COLOR="#FFFFFF" POINT-SIZE="16"><B>OrderService</B></FONT></TD></TR><TR><TD HEIGHT="6"></TD></TR></TABLE>>];
"IPricingService" [shape=plain label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" COLOR="#12263A" BGCOLOR="white"><TR><TD BGCOLOR="#2E7DAF" CELLPADDING="5"><FONT POINT-SIZE="11.5" COLOR="#FFFFFF">«interface»</FONT><BR/><FONT COLOR="#FFFFFF" POINT-SIZE="16"><B><I>IPricingService</I></B></FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5"><FONT FACE="Consolas" POINT-SIZE="13.5">+ Quote(PriceRequest) : PriceBreakdown<BR ALIGN="LEFT"/></FONT></TD></TR></TABLE>>];
"PricingService" [shape=plain label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" COLOR="#12263A" BGCOLOR="white"><TR><TD BGCOLOR="#24384C" CELLPADDING="5"><FONT POINT-SIZE="11.5" COLOR="#FFFFFF">«service»</FONT><BR/><FONT COLOR="#FFFFFF" POINT-SIZE="16"><B>PricingService</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5"><FONT FACE="Consolas" POINT-SIZE="13.5">- clock : IClock (UTC+7)<BR ALIGN="LEFT"/></FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5"><FONT FACE="Consolas" POINT-SIZE="13.5">+ Quote(req)<BR ALIGN="LEFT"/>- QuietDiscount  BR7<BR ALIGN="LEFT"/>- Voucher        BR9<BR ALIGN="LEFT"/>- DeliveryFee    BR3, BR6<BR ALIGN="LEFT"/>- Rush / Rain    BR4, BR5<BR ALIGN="LEFT"/>- RoundOnce      BR11<BR ALIGN="LEFT"/></FONT></TD></TR></TABLE>>];
"IHubLoadService" [shape=plain label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" COLOR="#12263A" BGCOLOR="white"><TR><TD BGCOLOR="#2E7DAF" CELLPADDING="5"><FONT POINT-SIZE="11.5" COLOR="#FFFFFF">«interface»</FONT><BR/><FONT COLOR="#FFFFFF" POINT-SIZE="16"><B><I>IHubLoadService</I></B></FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5"><FONT FACE="Consolas" POINT-SIZE="13.5">+ GetLoad(hubId) : decimal<BR ALIGN="LEFT"/>+ FindAlternatives(addr, km)<BR ALIGN="LEFT"/></FONT></TD></TR></TABLE>>];
"HubLoadService" [shape=plain label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" COLOR="#12263A" BGCOLOR="white"><TR><TD BGCOLOR="#24384C" CELLPADDING="5"><FONT POINT-SIZE="11.5" COLOR="#FFFFFF">«service»</FONT><BR/><FONT COLOR="#FFFFFF" POINT-SIZE="16"><B>HubLoadService</B></FONT></TD></TR><TR><TD HEIGHT="6"></TD></TR></TABLE>>];
"IOrderStateMachine" [shape=plain label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" COLOR="#12263A" BGCOLOR="white"><TR><TD BGCOLOR="#2E7DAF" CELLPADDING="5"><FONT POINT-SIZE="11.5" COLOR="#FFFFFF">«interface»</FONT><BR/><FONT COLOR="#FFFFFF" POINT-SIZE="16"><B><I>IOrderStateMachine</I></B></FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5"><FONT FACE="Consolas" POINT-SIZE="13.5">+ CanTransition(from, to, role)<BR ALIGN="LEFT"/>+ Transition(order, to, actor)<BR ALIGN="LEFT"/></FONT></TD></TR></TABLE>>];
"OrderStateMachine" [shape=plain label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" COLOR="#12263A" BGCOLOR="white"><TR><TD BGCOLOR="#24384C" CELLPADDING="5"><FONT POINT-SIZE="11.5" COLOR="#FFFFFF">«service»</FONT><BR/><FONT COLOR="#FFFFFF" POINT-SIZE="16"><B>OrderStateMachine</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5"><FONT FACE="Consolas" POINT-SIZE="13.5">- allowed : transition table<BR ALIGN="LEFT"/></FONT></TD></TR></TABLE>>];
"IPaymentStrategyResolver" [shape=plain label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" COLOR="#12263A" BGCOLOR="white"><TR><TD BGCOLOR="#2E7DAF" CELLPADDING="5"><FONT POINT-SIZE="11.5" COLOR="#FFFFFF">«interface»</FONT><BR/><FONT COLOR="#FFFFFF" POINT-SIZE="16"><B><I>IPaymentStrategyResolver</I></B></FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5"><FONT FACE="Consolas" POINT-SIZE="13.5">+ Resolve(method, type)<BR ALIGN="LEFT"/></FONT></TD></TR></TABLE>>];
"CheckoutController" -> "IOrderService" [style=dashed arrowhead=vee label=""];
"IOrderService" -> "OrderService" [dir=back arrowtail=empty style=dashed arrowsize=1.1];
"OrderService" -> "IPricingService" [style=dashed arrowhead=vee label=""];
"OrderService" -> "IHubLoadService" [style=dashed arrowhead=vee label=""];
"OrderService" -> "IOrderStateMachine" [style=dashed arrowhead=vee label=""];
"OrderService" -> "IPaymentStrategyResolver" [style=dashed arrowhead=vee label=""];
"IPricingService" -> "PricingService" [dir=back arrowtail=empty style=dashed arrowsize=1.1];
"IHubLoadService" -> "HubLoadService" [dir=back arrowtail=empty style=dashed arrowsize=1.1];
"IOrderStateMachine" -> "OrderStateMachine" [dir=back arrowtail=empty style=dashed arrowsize=1.1];
n1 [shape=note style=filled fillcolor="#FFF8E6" color="#E9A23B" fontsize=13 label="Pricing rules BR1–BR14 live only in\nPricingService (business layer),\nin the BR10 order with one rounding."];
"PricingService" -> n1 [style=dashed arrowhead=none color="#E9A23B"];
{rank=same; "IPricingService"; "IHubLoadService"; "IOrderStateMachine"; "IPaymentStrategyResolver"}
legend [shape=plain label=<<TABLE BORDER="0" CELLSPACING="4"><TR><TD BGCOLOR="#3B4A5A" WIDTH="14"></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="13">controller</FONT></TD><TD BGCOLOR="#2E7DAF" WIDTH="14"></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="13">interface</FONT></TD><TD BGCOLOR="#24384C" WIDTH="14"></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="13">service</FONT></TD></TR></TABLE>>];
}