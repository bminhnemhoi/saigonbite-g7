digraph E { graph [fontname="Segoe UI" bgcolor="white" pad="0.3" rankdir=LR nodesep=0.35 ranksep=1.1 splines=spline]; node [fontname="Segoe UI" fontsize=14 color="#12263A" fontcolor="#1F2933"]; edge [fontname="Segoe UI" fontsize=13 color="#3B4A5A" fontcolor="#3B4A5A" arrowsize=1.0 penwidth=1.4 labelfontsize=13];
Users [shape=plain label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" COLOR="#9AA5B1" BGCOLOR="white"><TR><TD COLSPAN="3" BGCOLOR="#12263A" CELLPADDING="5"><FONT COLOR="white" POINT-SIZE="15"><B>Users</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="Id" CELLPADDING="3"><FONT COLOR="#E9A23B" POINT-SIZE="12"><B>PK</B></FONT></TD><TD ALIGN="LEFT" CELLPADDING="3"><FONT FACE="Consolas" POINT-SIZE="13.5"><B>Id</B></FONT></TD><TD ALIGN="LEFT" CELLPADDING="3"><FONT FACE="Consolas" POINT-SIZE="12" COLOR="#5B6B7A">int</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="Email" CELLPADDING="3"><FONT COLOR="#1E8A5F" POINT-SIZE="12"><B>UK</B></FONT></TD><TD ALIGN="LEFT" CELLPADDING="3"><FONT FACE="Consolas" POINT-SIZE="13.5">Email</FONT></TD><TD ALIGN="LEFT" CELLPADDING="3"><FONT FACE="Consolas" POINT-SIZE="12" COLOR="#5B6B7A">nvarchar(256)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="PasswordHash" CELLPADDING="3"></TD><TD ALIGN="LEFT" CELLPADDING="3"><FONT FACE="Consolas" POINT-SIZE="13.5">PasswordHash</FONT></TD><TD ALIGN="LEFT" CELLPADDING="3"><FONT FACE="Consolas" POINT-SIZE="12" COLOR="#5B6B7A">nvarchar(max)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="Role" CELLPADDING="3"></TD><TD ALIGN="LEFT" CELLPADDING="3"><FONT FACE="Consolas" POINT-SIZE="13.5">Role</FONT></TD><TD ALIGN="LEFT" CELLPADDING="3"><FONT FACE="Consolas" POINT-SIZE="12" COLOR="#5B6B7A">tinyint</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="CustomerType" CELLPADDING="3"></TD><TD ALIGN="LEFT" CELLPADDING="3"><FONT FACE="Consolas" POINT-SIZE="13.5">CustomerType</FONT></TD><TD ALIGN="LEFT" CELLPADDING="3"><FONT FACE="Consolas" POINT-SIZE="12" COLOR="#5B6B7A">tinyint null</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="IsActive" CELLPADDING="3"></TD><TD ALIGN="LEFT" CELLPADDING="3"><FONT FACE="Consolas" POINT-SIZE="13.5">IsActive</FONT></TD><TD ALIGN="LEFT" CELLPADDING="3"><FONT FACE="Consolas" POINT-SIZE="12" COLOR="#5B6B7A">bit</FONT></TD></TR></TABLE>>];
LocalCustomerProfiles [shape=plain label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" COLOR="#9AA5B1" BGCOLOR="white"><TR><TD COLSPAN="3" BGCOLOR="#12263A" CELLPADDING="5"><FONT COLOR="white" POINT-SIZE="15"><B>LocalCustomerProfiles</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="UserId" CELLPADDING="3"><FONT COLOR="#E9A23B" POINT-SIZE="12"><B>PK,FK</B></FONT></TD><TD ALIGN="LEFT" CELLPADDING="3"><FONT FACE="Consolas" POINT-SIZE="13.5"><B>UserId</B></FONT></TD><TD ALIGN="LEFT" CELLPADDING="3"><FONT FACE="Consolas" POINT-SIZE="12" COLOR="#5B6B7A">int</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="PhoneNumber" CELLPADDING="3"><FONT COLOR="#1E8A5F" POINT-SIZE="12"><B>UK</B></FONT></TD><TD ALIGN="LEFT" CELLPADDING="3"><FONT FACE="Consolas" POINT-SIZE="13.5">PhoneNumber</FONT></TD><TD ALIGN="LEFT" CELLPADDING="3"><FONT FACE="Consolas" POINT-SIZE="12" COLOR="#5B6B7A">char(10)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="PhoneVerifiedAt" CELLPADDING="3"></TD><TD ALIGN="LEFT" CELLPADDING="3"><FONT FACE="Consolas" POINT-SIZE="13.5">PhoneVerifiedAt</FONT></TD><TD ALIGN="LEFT" CELLPADDING="3"><FONT FACE="Consolas" POINT-SIZE="12" COLOR="#5B6B7A">datetime2</FONT></TD></TR></TABLE>>];
TouristProfiles [shape=plain label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" COLOR="#9AA5B1" BGCOLOR="white"><TR><TD COLSPAN="3" BGCOLOR="#12263A" CELLPADDING="5"><FONT COLOR="white" POINT-SIZE="15"><B>TouristProfiles</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="UserId" CELLPADDING="3"><FONT COLOR="#E9A23B" POINT-SIZE="12"><B>PK,FK</B></FONT></TD><TD ALIGN="LEFT" CELLPADDING="3"><FONT FACE="Consolas" POINT-SIZE="13.5"><B>UserId</B></FONT></TD><TD ALIGN="LEFT" CELLPADDING="3"><FONT FACE="Consolas" POINT-SIZE="12" COLOR="#5B6B7A">int</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="PassportNumber" CELLPADDING="3"><FONT COLOR="#1E8A5F" POINT-SIZE="12"><B>UK</B></FONT></TD><TD ALIGN="LEFT" CELLPADDING="3"><FONT FACE="Consolas" POINT-SIZE="13.5">PassportNumber</FONT></TD><TD ALIGN="LEFT" CELLPADDING="3"><FONT FACE="Consolas" POINT-SIZE="12" COLOR="#5B6B7A">nvarchar(9)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="Nationality" CELLPADDING="3"></TD><TD ALIGN="LEFT" CELLPADDING="3"><FONT FACE="Consolas" POINT-SIZE="13.5">Nationality</FONT></TD><TD ALIGN="LEFT" CELLPADDING="3"><FONT FACE="Consolas" POINT-SIZE="12" COLOR="#5B6B7A">nvarchar(64)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="EmailVerifiedAt" CELLPADDING="3"></TD><TD ALIGN="LEFT" CELLPADDING="3"><FONT FACE="Consolas" POINT-SIZE="13.5">EmailVerifiedAt</FONT></TD><TD ALIGN="LEFT" CELLPADDING="3"><FONT FACE="Consolas" POINT-SIZE="12" COLOR="#5B6B7A">datetime2</FONT></TD></TR></TABLE>>];
StaffProfiles [shape=plain label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" COLOR="#9AA5B1" BGCOLOR="white"><TR><TD COLSPAN="3" BGCOLOR="#12263A" CELLPADDING="5"><FONT COLOR="white" POINT-SIZE="15"><B>StaffProfiles</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="UserId" CELLPADDING="3"><FONT COLOR="#E9A23B" POINT-SIZE="12"><B>PK,FK</B></FONT></TD><TD ALIGN="LEFT" CELLPADDING="3"><FONT FACE="Consolas" POINT-SIZE="13.5"><B>UserId</B></FONT></TD><TD ALIGN="LEFT" CELLPADDING="3"><FONT FACE="Consolas" POINT-SIZE="12" COLOR="#5B6B7A">int</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="HubId" CELLPADDING="3"><FONT COLOR="#2E7DAF" POINT-SIZE="12"><B>FK</B></FONT></TD><TD ALIGN="LEFT" CELLPADDING="3"><FONT FACE="Consolas" POINT-SIZE="13.5">HubId</FONT></TD><TD ALIGN="LEFT" CELLPADDING="3"><FONT FACE="Consolas" POINT-SIZE="12" COLOR="#5B6B7A">int null</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="IsAvailable" CELLPADDING="3"></TD><TD ALIGN="LEFT" CELLPADDING="3"><FONT FACE="Consolas" POINT-SIZE="13.5">IsAvailable</FONT></TD><TD ALIGN="LEFT" CELLPADDING="3"><FONT FACE="Consolas" POINT-SIZE="12" COLOR="#5B6B7A">bit</FONT></TD></TR></TABLE>>];
Hubs [shape=plain label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" COLOR="#9AA5B1" BGCOLOR="white"><TR><TD COLSPAN="3" BGCOLOR="#12263A" CELLPADDING="5"><FONT COLOR="white" POINT-SIZE="15"><B>Hubs</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="Id" CELLPADDING="3"><FONT COLOR="#E9A23B" POINT-SIZE="12"><B>PK</B></FONT></TD><TD ALIGN="LEFT" CELLPADDING="3"><FONT FACE="Consolas" POINT-SIZE="13.5"><B>Id</B></FONT></TD><TD ALIGN="LEFT" CELLPADDING="3"><FONT FACE="Consolas" POINT-SIZE="12" COLOR="#5B6B7A">int</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="Name" CELLPADDING="3"></TD><TD ALIGN="LEFT" CELLPADDING="3"><FONT FACE="Consolas" POINT-SIZE="13.5">Name</FONT></TD><TD ALIGN="LEFT" CELLPADDING="3"><FONT FACE="Consolas" POINT-SIZE="12" COLOR="#5B6B7A">nvarchar(100)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="Address" CELLPADDING="3"></TD><TD ALIGN="LEFT" CELLPADDING="3"><FONT FACE="Consolas" POINT-SIZE="13.5">Address</FONT></TD><TD ALIGN="LEFT" CELLPADDING="3"><FONT FACE="Consolas" POINT-SIZE="12" COLOR="#5B6B7A">nvarchar(256)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="KitchenCapacity" CELLPADDING="3"></TD><TD ALIGN="LEFT" CELLPADDING="3"><FONT FACE="Consolas" POINT-SIZE="13.5">KitchenCapacity</FONT></TD><TD ALIGN="LEFT" CELLPADDING="3"><FONT FACE="Consolas" POINT-SIZE="12" COLOR="#5B6B7A">int &gt; 0</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="IsActive" CELLPADDING="3"></TD><TD ALIGN="LEFT" CELLPADDING="3"><FONT FACE="Consolas" POINT-SIZE="13.5">IsActive</FONT></TD><TD ALIGN="LEFT" CELLPADDING="3"><FONT FACE="Consolas" POINT-SIZE="12" COLOR="#5B6B7A">bit</FONT></TD></TR></TABLE>>];
HubBrands [shape=plain label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" COLOR="#9AA5B1" BGCOLOR="white"><TR><TD COLSPAN="3" BGCOLOR="#12263A" CELLPADDING="5"><FONT COLOR="white" POINT-SIZE="15"><B>HubBrands</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="HubId" CELLPADDING="3"><FONT COLOR="#E9A23B" POINT-SIZE="12"><B>PK,FK</B></FONT></TD><TD ALIGN="LEFT" CELLPADDING="3"><FONT FACE="Consolas" POINT-SIZE="13.5"><B>HubId</B></FONT></TD><TD ALIGN="LEFT" CELLPADDING="3"><FONT FACE="Consolas" POINT-SIZE="12" COLOR="#5B6B7A">int</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="BrandId" CELLPADDING="3"><FONT COLOR="#E9A23B" POINT-SIZE="12"><B>PK,FK</B></FONT></TD><TD ALIGN="LEFT" CELLPADDING="3"><FONT FACE="Consolas" POINT-SIZE="13.5"><B>BrandId</B></FONT></TD><TD ALIGN="LEFT" CELLPADDING="3"><FONT FACE="Consolas" POINT-SIZE="12" COLOR="#5B6B7A">int</FONT></TD></TR></TABLE>>];
Brands [shape=plain label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" COLOR="#9AA5B1" BGCOLOR="white"><TR><TD COLSPAN="3" BGCOLOR="#12263A" CELLPADDING="5"><FONT COLOR="white" POINT-SIZE="15"><B>Brands</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="Id" CELLPADDING="3"><FONT COLOR="#E9A23B" POINT-SIZE="12"><B>PK</B></FONT></TD><TD ALIGN="LEFT" CELLPADDING="3"><FONT FACE="Consolas" POINT-SIZE="13.5"><B>Id</B></FONT></TD><TD ALIGN="LEFT" CELLPADDING="3"><FONT FACE="Consolas" POINT-SIZE="12" COLOR="#5B6B7A">int</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="Name" CELLPADDING="3"></TD><TD ALIGN="LEFT" CELLPADDING="3"><FONT FACE="Consolas" POINT-SIZE="13.5">Name</FONT></TD><TD ALIGN="LEFT" CELLPADDING="3"><FONT FACE="Consolas" POINT-SIZE="12" COLOR="#5B6B7A">nvarchar(100)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="Category" CELLPADDING="3"></TD><TD ALIGN="LEFT" CELLPADDING="3"><FONT FACE="Consolas" POINT-SIZE="13.5">Category</FONT></TD><TD ALIGN="LEFT" CELLPADDING="3"><FONT FACE="Consolas" POINT-SIZE="12" COLOR="#5B6B7A">nvarchar(50)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="IsActive" CELLPADDING="3"></TD><TD ALIGN="LEFT" CELLPADDING="3"><FONT FACE="Consolas" POINT-SIZE="13.5">IsActive</FONT></TD><TD ALIGN="LEFT" CELLPADDING="3"><FONT FACE="Consolas" POINT-SIZE="12" COLOR="#5B6B7A">bit</FONT></TD></TR></TABLE>>];
MenuItems [shape=plain label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" COLOR="#9AA5B1" BGCOLOR="white"><TR><TD COLSPAN="3" BGCOLOR="#12263A" CELLPADDING="5"><FONT COLOR="white" POINT-SIZE="15"><B>MenuItems</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="Id" CELLPADDING="3"><FONT COLOR="#E9A23B" POINT-SIZE="12"><B>PK</B></FONT></TD><TD ALIGN="LEFT" CELLPADDING="3"><FONT FACE="Consolas" POINT-SIZE="13.5"><B>Id</B></FONT></TD><TD ALIGN="LEFT" CELLPADDING="3"><FONT FACE="Consolas" POINT-SIZE="12" COLOR="#5B6B7A">int</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="BrandId" CELLPADDING="3"><FONT COLOR="#2E7DAF" POINT-SIZE="12"><B>FK</B></FONT></TD><TD ALIGN="LEFT" CELLPADDING="3"><FONT FACE="Consolas" POINT-SIZE="13.5">BrandId</FONT></TD><TD ALIGN="LEFT" CELLPADDING="3"><FONT FACE="Consolas" POINT-SIZE="12" COLOR="#5B6B7A">int</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="Name" CELLPADDING="3"></TD><TD ALIGN="LEFT" CELLPADDING="3"><FONT FACE="Consolas" POINT-SIZE="13.5">Name</FONT></TD><TD ALIGN="LEFT" CELLPADDING="3"><FONT FACE="Consolas" POINT-SIZE="12" COLOR="#5B6B7A">nvarchar(120)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="Price" CELLPADDING="3"></TD><TD ALIGN="LEFT" CELLPADDING="3"><FONT FACE="Consolas" POINT-SIZE="13.5">Price</FONT></TD><TD ALIGN="LEFT" CELLPADDING="3"><FONT FACE="Consolas" POINT-SIZE="12" COLOR="#5B6B7A">decimal(12,0)</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="IsAvailable" CELLPADDING="3"></TD><TD ALIGN="LEFT" CELLPADDING="3"><FONT FACE="Consolas" POINT-SIZE="13.5">IsAvailable</FONT></TD><TD ALIGN="LEFT" CELLPADDING="3"><FONT FACE="Consolas" POINT-SIZE="12" COLOR="#5B6B7A">bit</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="IsDeleted" CELLPADDING="3"></TD><TD ALIGN="LEFT" CELLPADDING="3"><FONT FACE="Consolas" POINT-SIZE="13.5">IsDeleted</FONT></TD><TD ALIGN="LEFT" CELLPADDING="3"><FONT FACE="Consolas" POINT-SIZE="12" COLOR="#5B6B7A">bit</FONT></TD></TR></TABLE>>];
Users:Id -> LocalCustomerProfiles:UserId [dir=both arrowtail=teetee arrowhead=teeodot];
Users:Id -> TouristProfiles:UserId [dir=both arrowtail=teetee arrowhead=teeodot];
Users:Id -> StaffProfiles:UserId [dir=both arrowtail=teetee arrowhead=teeodot];
Hubs:Id -> StaffProfiles:HubId [dir=both arrowtail=teeodot arrowhead=crowodot];
Hubs:Id -> HubBrands:HubId [dir=both arrowtail=teetee arrowhead=crowodot];
Brands:Id -> HubBrands:BrandId [dir=both arrowtail=teetee arrowhead=crowodot];
Brands:Id -> MenuItems:BrandId [dir=both arrowtail=teetee arrowhead=crowodot];
{rank=same; Users; Hubs; Brands}
}