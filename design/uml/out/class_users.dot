digraph G { graph [fontname="Segoe UI" bgcolor="white" pad="0.3" rankdir=TB nodesep=0.45 ranksep=0.6 splines=spline]; node [fontname="Segoe UI" fontsize=14 color="#12263A" fontcolor="#1F2933"]; edge [fontname="Segoe UI" fontsize=13 color="#3B4A5A" fontcolor="#3B4A5A" arrowsize=1.0 penwidth=1.4 labelfontsize=13];
"User" [shape=plain label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" COLOR="#12263A" BGCOLOR="white"><TR><TD BGCOLOR="#12263A" CELLPADDING="5"><FONT POINT-SIZE="11.5" COLOR="#FFFFFF">«abstract»</FONT><BR/><FONT COLOR="#FFFFFF" POINT-SIZE="16"><B><I>User</I></B></FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5"><FONT FACE="Consolas" POINT-SIZE="13.5">+ Id : int<BR ALIGN="LEFT"/>+ Email : string<BR ALIGN="LEFT"/>+ PasswordHash : string<BR ALIGN="LEFT"/>+ Role : Role<BR ALIGN="LEFT"/>+ IsActive : bool<BR ALIGN="LEFT"/></FONT></TD></TR></TABLE>>];
"Customer" [shape=plain label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" COLOR="#12263A" BGCOLOR="white"><TR><TD BGCOLOR="#12263A" CELLPADDING="5"><FONT POINT-SIZE="11.5" COLOR="#FFFFFF">«abstract»</FONT><BR/><FONT COLOR="#FFFFFF" POINT-SIZE="16"><B><I>Customer</I></B></FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5"><FONT FACE="Consolas" POINT-SIZE="13.5">+ Type : CustomerType<BR ALIGN="LEFT"/>+ DisplayName : string<BR ALIGN="LEFT"/></FONT></TD></TR></TABLE>>];
"LocalCustomer" [shape=plain label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" COLOR="#12263A" BGCOLOR="white"><TR><TD BGCOLOR="#12263A" CELLPADDING="5"><FONT COLOR="#FFFFFF" POINT-SIZE="16"><B>LocalCustomer</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5"><FONT FACE="Consolas" POINT-SIZE="13.5">+ PhoneNumber : string<BR ALIGN="LEFT"/>+ PhoneVerifiedAt : DateTime?<BR ALIGN="LEFT"/></FONT></TD></TR></TABLE>>];
"ForeignTourist" [shape=plain label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" COLOR="#12263A" BGCOLOR="white"><TR><TD BGCOLOR="#12263A" CELLPADDING="5"><FONT COLOR="#FFFFFF" POINT-SIZE="16"><B>ForeignTourist</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5"><FONT FACE="Consolas" POINT-SIZE="13.5">+ PassportNumber : string<BR ALIGN="LEFT"/>+ Nationality : string<BR ALIGN="LEFT"/>+ EmailVerifiedAt : DateTime?<BR ALIGN="LEFT"/></FONT></TD></TR></TABLE>>];
"KitchenStaff" [shape=plain label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" COLOR="#12263A" BGCOLOR="white"><TR><TD BGCOLOR="#12263A" CELLPADDING="5"><FONT COLOR="#FFFFFF" POINT-SIZE="16"><B>KitchenStaff</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5"><FONT FACE="Consolas" POINT-SIZE="13.5">+ HubId : int<BR ALIGN="LEFT"/></FONT></TD></TR></TABLE>>];
"Shipper" [shape=plain label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" COLOR="#12263A" BGCOLOR="white"><TR><TD BGCOLOR="#12263A" CELLPADDING="5"><FONT COLOR="#FFFFFF" POINT-SIZE="16"><B>Shipper</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5"><FONT FACE="Consolas" POINT-SIZE="13.5">+ IsAvailable : bool<BR ALIGN="LEFT"/></FONT></TD></TR></TABLE>>];
"SystemAdmin" [shape=plain label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" COLOR="#12263A" BGCOLOR="white"><TR><TD BGCOLOR="#12263A" CELLPADDING="5"><FONT COLOR="#FFFFFF" POINT-SIZE="16"><B>SystemAdmin</B></FONT></TD></TR><TR><TD HEIGHT="6"></TD></TR></TABLE>>];
"Hub" [shape=plain label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" COLOR="#12263A" BGCOLOR="white"><TR><TD BGCOLOR="#12263A" CELLPADDING="5"><FONT COLOR="#FFFFFF" POINT-SIZE="16"><B>Hub</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT" CELLPADDING="5"><FONT FACE="Consolas" POINT-SIZE="13.5">+ Name : string<BR ALIGN="LEFT"/>+ KitchenCapacity : int<BR ALIGN="LEFT"/></FONT></TD></TR></TABLE>>];
"User" -> "Customer" [dir=back arrowtail=empty arrowsize=1.1];
"User" -> "KitchenStaff" [dir=back arrowtail=empty arrowsize=1.1];
"User" -> "Shipper" [dir=back arrowtail=empty arrowsize=1.1];
"User" -> "SystemAdmin" [dir=back arrowtail=empty arrowsize=1.1];
"Customer" -> "LocalCustomer" [dir=back arrowtail=empty arrowsize=1.1];
"Customer" -> "ForeignTourist" [dir=back arrowtail=empty arrowsize=1.1];
"Hub" -> "KitchenStaff" [dir=both arrowtail=odiamond arrowhead=none taillabel="1" headlabel="*" label="  employs"];
n1 [shape=note style=filled fillcolor="#FFF8E6" color="#E9A23B" fontsize=13 label="One schema (BR18, FR1): a single Users table\nholds login, password hash and role;\nLocal and Tourist data live in one profile\ntable per type (EF Core table-per-type)."];
"Customer" -> n1 [style=dashed arrowhead=none color="#E9A23B"];
{rank=same; "Customer"; "KitchenStaff"; "Shipper"; "SystemAdmin"}
{rank=same; "LocalCustomer"; "ForeignTourist"; n1}
}